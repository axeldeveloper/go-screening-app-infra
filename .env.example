# Copie para .env (ignorado pelo git) e preencha.
#
# POSTGRES_PASSWORD: senha do usuário postgres (banco do app, my_screening_app).
# SONAR_DB_PASSWORD: senha do usuário sonar (banco dedicado do SonarQube).
# SONAR_TOKEN: token gerado no SonarQube (My Account > Security) ou no CI.
#
# Use apenas letras/números nas senhas do banco: o script db/init/01-sonarqube.sh
# as interpola em SQL.

# App — o Compose lê este arquivo; para rodar o app no host, carregue no shell
# com `set -a && . ./.env && set +a`.
APP_NAME=my-screening-app
PORT=8000
ENVIRONMENT=Development
# Host: 5433 (o Compose publica 5433:5432). A senha deve ser igual a POSTGRES_PASSWORD.
DATABASE_URL=postgres://postgres:troque-esta-senha@localhost:5433/my_screening_app

POSTGRES_PASSWORD=troque-esta-senha
SONAR_DB_PASSWORD=troque-esta-senha
SONAR_TOKEN=cole-o-token-aqui

# Para rodar o sonar-scanner fora do Compose (opcional):
# SONAR_HOST_URL=http://localhost:9001
